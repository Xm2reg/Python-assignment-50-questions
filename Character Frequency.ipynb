   "source": [
    "us = input(\"Enter a string to analyze: \")\n",
    "\n",
    "character = dict()\n",
    "\n",
    "for u in us:\n",
    "    if u in character:\n",
    "        character[u] += 1\n",
    "    else:\n",
    "        character[u] = 1\n",
    "        \n",
    "for key, value in character.items():\n",
    "    print(f\"'{key}': {value}\")"
   ]
