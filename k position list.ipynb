     "output_type": "stream",
     "text": [
      "Enter the value of list separated by comma: 1,2,3,4,5,6,7,8,9\n",
      "Enter number of positions to rotate left:  4\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Left rotated list: [5, 6, 7, 8, 9, 1, 2, 3, 4]\n"
     ]
    }
   ],
   "source": [
    "my_list = [int(x) for x in input(\"Enter the value of list separated by comma:\").split(',')]\n",
    "k = int(input(\"Enter number of positions to rotate left: \"))\n",
    "\n",
    "k = k % len(my_list)\n",
    "\n",
    "rotated_list = my_list[k:] + my_list[:k]\n",
    "\n",
    "print(f\"Left rotated list: {rotated_list}\")"
   ]
  },
