   "source": [
    "list1 = input(\"Enter first list (spaces separated): \").split()\n",
    "list2 = input(\"Enter second list (spaces separated): \").split()\n",
    "\n",
    "common_elements = [x for x in list1 if x in list2]\n",
    "\n",
    "unique_common = list(dict.fromkeys(common_elements))\n",
    "\n",
    "print(f\"Common elements: {unique_common}\")"
   ]
