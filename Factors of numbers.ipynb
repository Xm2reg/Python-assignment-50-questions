   "source": [
    "num = int(input(\"Enter a positive number: \"))\n",
    "\n",
    "factors = [i for i in range(1, num + 1) if num % i == 0]\n",
    "\n",
    "print(f\"The factors of {num} are: {factors}\")"
   ]
