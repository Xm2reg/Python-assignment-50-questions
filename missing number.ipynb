   "source": [
    "# Example list missing the number 3\n",
    "li = [1, 2, 4, 5, 6]\n",
    "\n",
    "n = len(li) + 1\n",
    "\n",
    "expected_sum = n * (n + 1) // 2\n",
    "\n",
    "missing_number = expected_sum - sum(li)\n",
    "\n",
    "print(f\"The missing number is: {missing_number}\")"
   ]
