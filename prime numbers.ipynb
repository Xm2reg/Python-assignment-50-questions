   ],
   "source": [
    "n = int(input(\"Enter the upper limit (n): \"))\n",
    "\n",
    "primes = [x for x in range(2, n + 1) if all(x % d != 0 for d in range(2, int(x**0.5) + 1))]\n",
    "\n",
    "print(f\"Prime numbers from 2 to {n}: {primes}\")"
   ]
