     "text": [
      "Enter a positive number:  28\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Factors of number are:[1, 2, 4, 7, 14]\n",
      "Provided number 28 is perfect number.\n"
     ]
    }
   ],
   "source": [
    "num = int(input(\"Enter a positive number: \"))\n",
    "\n",
    "factors = [i for i in range(1, num) if num % i == 0 ]\n",
    "\n",
    "print(f\"Factors of number are:{factors}\")\n",
    "\n",
    "a = sum(factors)\n",
    "\n",
    "if num == a:\n",
    "    print(f\"Provided number {num} is perfect number.\")"
   ]
  },
