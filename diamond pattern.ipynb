   "source": [
    "n = int(input(\"Enter the size of the diamond: \"))\n",
    "\n",
    "for i in range(-n + 1, n):\n",
    "    spaces = abs(i)\n",
    "    stars = 2 * (n - spaces) - 1\n",
    "    print(\" \" * spaces + \"*\" * stars)"
   ]
