   "source": [
    "li = input(\"Enter the sentence: \").split()\n",
    "\n",
    "max_len = len(max(li, key=len))\n",
    "\n",
    "longest_words = [word for word in li if len(word) == max_len]\n",
    "\n",
    "print(f\"Max length is {max_len}.\")\n",
    "print(f\"The longest words: {longest_words}\")"
   ]
