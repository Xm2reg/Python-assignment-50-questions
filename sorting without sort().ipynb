   "source": [
    "original_list = [64, 34, 25, 12, 22, 11, 90]\n",
    "sorted_list = []\n",
    "\n",
    "while original_list:\n",
    "\n",
    "    smallest = min(original_list)\n",
    "    \n",
    "    sorted_list.append(smallest)\n",
    "    \n",
    "    original_list.remove(smallest)\n",
    "\n",
    "print(f\"Sorted list: {sorted_list}\")\n"
   ]
